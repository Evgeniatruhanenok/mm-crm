# ── Whitelist: the repository contains only code + design system ──
# Research, interviews, PRD drafts and agent directives stay local.
/*
!/.gitignore
!/README.md
!/PROJECT.md
!/package.json
!/package-lock.json
!/index.html
!/components.json
!/vite.config.ts
!/vitest.shims.d.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/.oxlintrc.json
!/src/
!/public/
!/.storybook/
!/ds/

# ── Never commit ──
node_modules
dist
dist-ssr
build
storybook-static
.tmp
*.local
.env*
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
